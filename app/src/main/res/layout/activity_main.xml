<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Contador de Puntos Principales -->
    <TextView
        android:id="@+id/tvPuntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntos: 0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Contenedor para CPS Actual y Máximo CPS -->
    <LinearLayout
        android:id="@+id/layoutCps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvPuntos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvCps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPS: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tvMaxCps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máx CPS: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"/>
    </LinearLayout>

    <!-- Indicador y Barra de Felicidad -->
    <TextView
        android:id="@+id/tvFelicidadEtiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Felicidad: 100%"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#388E3C"
        app:layout_constraintTop_toBottomOf="@id/layoutCps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <ProgressBar
        android:id="@+id/pbFelicidad"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:max="100"
        android:progress="100"
        app:layout_constraintTop_toBottomOf="@id/tvFelicidadEtiqueta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="4dp"/>

    <!-- Banner Destacado para el QTE (Invisible por defecto) -->
    <TextView
        android:id="@+id/tvQteBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="⚡ ¡EVENTO RÁPIDO! ¡ALCANZA 12 CPS! ⚡"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#D32F2F"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pbFelicidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Imagen de la Mascota -->
    <ImageView
        android:id="@+id/ivMascota"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="Mascota Virtual"
        android:src="@android:drawable/btn_star_big_on"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tvQteBanner"
        app:layout_constraintBottom_toTopOf="@id/tvMensaje"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mensaje / Globo de Diálogo -->
    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="¡Hola! Tócame para jugar conmigo."
        android:textAlignment="center"
        android:textSize="18sp"
        android:textColor="#555555"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>